{
  "name": "@masaori/zod-to-entity-definitions",
  "version": "1.1.10",
  "description": "A library to define data models using Zod with extended metadata and convert them into framework-agnostic Entity Definitions",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "npm run check-types && npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "zod",
    "entity",
    "orm",
    "schema",
    "typescript",
    "entity-definition",
    "er-model"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masaori/zod-to-entity-definitions.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.2.0",
    "@types/node": "26.6.5",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "semantic-release": "25.0.9",
    "tsup": "^8.3.5",
    "tsx": "4.23.15",
    "typescript": "^5.7.2",
    "vitest": "5.0.3",
    "zod": "4.6.6"
  }
}
